{
  "name": "airdrop-hunter",
  "private": true,
  "version": "0.3.1",
  "description": "AirdropHunter: pencarian luas, reward per wallet, dan pemeriksaan distribusi token gratis serta nilai pasar. Gas boleh terpisah; transaksi klaim belum diaktifkan.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "test": "node scripts/test.mjs",
    "test:stage4": "node scripts/test.mjs --stage4",
    "test:discovery": "node scripts/test.mjs --discovery",
    "test:value": "node scripts/test.mjs --value",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "viem": "^2.57.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
